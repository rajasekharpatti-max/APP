//@version=5
// AJ Flow v9 — dashboard = LABEL (always visible). No ta.sum, no timeframe.in_seconds, no table frames.
// BUY/SELL on bar close when FLOW + VOLUME agree and price rejects EMA21.
// SL / TP1 / TP2 plotted. Not financial advice. Use tiny size. 650 Rs loss = stop trading size, not add size.
strategy("AJ Flow v9", overlay=true, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.03, slippage=2, max_labels_count=500, max_lines_count=200)

emaF = input.int(21, "EMA fast")
emaS = input.int(55, "EMA slow")
rvolMin = input.float(1.0, "RVOL min", step=0.05)
needVol = input.bool(true, "Need volume TRUE")
tp1R = input.float(1.5, "TP1 R", step=0.1)
tp2R = input.float(2.0, "TP2 R", step=0.1)
coolN = input.int(4, "Cooldown bars")

htf = timeframe.period == "1" or timeframe.period == "3" or timeframe.period == "5" or timeframe.period == "15" ? "60" : "240"

e21 = ta.ema(close, emaF)
e55 = ta.ema(close, emaS)
vw = ta.vwap(hlc3)
atr = ta.atr(14)
body = math.abs(close - open)

volMa = ta.sma(volume, 20)
rvol = volMa == 0 ? 0.0 : volume / volMa
buyV = ta.sma(close >= open ? volume : 0.0, 5) * 5
selV = ta.sma(close < open ? volume : 0.0, 5) * 5
volBuy = rvol >= rvolMin and buyV > selV
volSel = rvol >= rvolMin and selV > buyV
volTxt = volSel ? "TRUE SELL" : volBuy ? "TRUE BUY" : "FALSE"

htfC = request.security(syminfo.tickerid, htf, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htfE = request.security(syminfo.tickerid, htf, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfUp = htfC > htfE

flowUp = close > e21 and e21 > e55
flowDn = close < e21 and e21 < e55
flowTxt = flowUp ? "BULLISH" : flowDn ? "BEARISH" : "CHOP"

climax = body > atr * 0.9
rejUp = low <= e21 and close > e21 and close > open and body > atr * 0.2
rejDn = high >= e21 and close < e21 and close < open and body > atr * 0.2
xUp = ta.crossover(close, e21) and body > atr * 0.2
xDn = ta.crossunder(close, e21) and body > atr * 0.2

buyRaw = flowUp and (not needVol or volBuy) and (rejUp or xUp) and not climax
selRaw = flowDn and (not needVol or volSel) and (rejDn or xDn) and not climax

var int lastB = na
okGap = na(lastB) or bar_index - lastB >= coolN
buySig = barstate.isconfirmed and buyRaw and okGap
selSig = barstate.isconfirmed and selRaw and okGap and not buySig
if buySig or selSig
    lastB := bar_index

slL = math.min(ta.lowest(low, 5), close - atr * 0.35)
slS = math.max(ta.highest(high, 5), close + atr * 0.35)
tp1L = close + math.max(close - slL, atr * 0.3) * tp1R
tp2L = close + math.max(close - slL, atr * 0.3) * tp2R
tp1S = close - math.max(slS - close, atr * 0.3) * tp1R
tp2S = close - math.max(slS - close, atr * 0.3) * tp2R

if buySig
    strategy.close("S")
    strategy.entry("L", strategy.long)
    strategy.exit("L1", "L", qty_percent=50, stop=slL, limit=tp1L)
    strategy.exit("L2", "L", stop=slL, limit=tp2L)
if selSig
    strategy.close("L")
    strategy.entry("S", strategy.short)
    strategy.exit("S1", "S", qty_percent=50, stop=slS, limit=tp1S)
    strategy.exit("S2", "S", stop=slS, limit=tp2S)

var float pSl = na
var float pT1 = na
var float pT2 = na
if buySig
    pSl := slL
    pT1 := tp1L
    pT2 := tp2L
if selSig
    pSl := slS
    pT1 := tp1S
    pT2 := tp2S
if strategy.position_size == 0 and not buySig and not selSig
    pSl := na
    pT1 := na
    pT2 := na

a = plot(e21, "EMA21", color.new(#00e5ff, 0), 2)
b = plot(e55, "EMA55", color.new(#ffab00, 0), 2)
fill(a, b, color=e21 > e55 ? color.new(#00c853, 85) : color.new(#ff1744, 85))
plot(vw, "VWAP", color.yellow, 2)
plot(pSl, "SL", color.red, 3, plot.style_linebr)
plot(pT1, "TP1", color.lime, 2, plot.style_linebr)
plot(pT2, "TP2", color.green, 3, plot.style_linebr)
bgcolor(flowUp ? color.new(#00c853, 88) : flowDn ? color.new(#ff1744, 88) : color.new(#ffd600, 90))
plotshape(buySig, title="BUY", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white, size=size.normal)
plotshape(selSig, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white, size=size.normal)

sig = buySig ? "BUY" : selSig ? "SELL" : flowDn and volSel ? "WAIT SELL" : flowUp and volBuy ? "WAIT BUY" : "NO SIGNAL"
slTx = na(pSl) ? "-" : str.tostring(pSl, format.mintick)
t1Tx = na(pT1) ? "-" : str.tostring(pT1, format.mintick)
t2Tx = na(pT2) ? "-" : str.tostring(pT2, format.mintick)
msg = "AJ v9  " + sig + "\nFLOW  " + flowTxt + "\nVOL   " + volTxt + "  RVOL " + str.tostring(rvol, "#.00") + "\nHTF   " + (htfUp ? "BULL" : "BEAR") + "  " + htf + "\nVWAP  " + (close > vw ? "ABOVE" : "BELOW") + "\nSL " + slTx + "\nTP1 " + t1Tx + "\nTP2 " + t2Tx

var label dash = na
if barstate.islast
    if not na(dash)
        label.delete(dash)
    col = buySig ? color.green : selSig ? color.red : flowDn ? color.new(#b71c1c, 0) : flowUp ? color.new(#1b5e20, 0) : color.new(#212121, 0)
    dash := label.new(bar_index, high, msg, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_label_down, color=col, textcolor=color.white, size=size.normal, textalign=text.align_left)

alertcondition(buySig, "BUY", "BUY")
alertcondition(selSig, "SELL", "SELL")
