//@version=5
// Confluence Signals v2 — XAUUSD / Nifty (non-repainting, bar-close only)
// Not financial advice. Do not take HTF bias as an entry.
indicator("Confluence Signals v2", overlay=true, max_labels_count=500, max_lines_count=500)

// ── Inputs ──────────────────────────────────────────────────────────────────
grpInst = "Instrument"
preset = input.string("Auto", "Preset", options=["Auto", "Gold", "Nifty", "Custom"], group=grpInst, tooltip="Auto: Gold session for XAU/GOLD, Nifty cash hours for NIFTY/BANKNIFTY. Do not run the Gold preset on Nifty.")

grpTrend = "Trend"
htf        = input.timeframe("60", "Higher timeframe", group=grpTrend)
htfEmaLen  = input.int(50, "HTF EMA", minval=5, group=grpTrend, tooltip="Use 50, not 200. Gold 60m EMA200 stays bull for months and would hide every SELL.")
emaFastLen = input.int(21, "Fast EMA", minval=2, group=grpTrend)
emaSlowLen = input.int(55, "Slow EMA", minval=2, group=grpTrend)
emaBiasLen = input.int(200, "Chart bias EMA", minval=50, group=grpTrend)
tradeMode  = input.string("Pullback OK", "Signal mode", options=["Pullback OK", "HTF must agree"], group=grpTrend, tooltip="Pullback OK: SELL can print when local EMA+ST+MACD agree even if HTF 50 is still bull. Never BUY while local EMAs are bear.")

grpSt = "Supertrend"
stAtrLen = input.int(10, "ATR length", minval=1, group=grpSt)
stFactor = input.float(3.0, "Factor (use 2.2 on Nifty 5m)", minval=0.5, step=0.1, group=grpSt)

grpMom = "Momentum"
rsiLen     = input.int(14, "RSI length", minval=2, group=grpMom)
rsiBuyMin  = input.int(48, "RSI min BUY", minval=1, maxval=70, group=grpMom)
rsiBuyMax  = input.int(68, "RSI max BUY", minval=50, maxval=90, group=grpMom)
rsiSellMin = input.int(32, "RSI min SELL", minval=10, maxval=50, group=grpMom)
rsiSellMax = input.int(52, "RSI max SELL", minval=30, maxval=99, group=grpMom)
macdFast   = input.int(12, "MACD fast", minval=2, group=grpMom)
macdSlow   = input.int(26, "MACD slow", minval=2, group=grpMom)
macdSig    = input.int(9, "MACD signal", minval=2, group=grpMom)

grpVol = "Volatility / ADX"
adxLen     = input.int(14, "ADX length", minval=2, group=grpVol)
adxMin     = input.float(18.0, "Min ADX", minval=1, step=0.5, group=grpVol)
atrLen     = input.int(14, "ATR length", minval=1, group=grpVol)
atrMinMult = input.float(0.35, "Min ATR vs SMA(ATR)", minval=0.05, step=0.05, group=grpVol)

grpSess = "Session"
useSession = input.bool(true, "Only signal in session", group=grpSess)
customSess = input.session("0700-1700", "Custom session (Custom preset)", group=grpSess)

grpRisk = "Stop / target"
slAtr      = input.float(1.5, "Stop ATR", minval=0.5, step=0.1, group=grpRisk)
tp1Atr     = input.float(2.0, "TP1 ATR", minval=0.5, step=0.1, group=grpRisk)
tp2Atr     = input.float(3.5, "TP2 ATR", minval=0.5, step=0.1, group=grpRisk)
showLevels = input.bool(true, "Draw SL / TP on signal", group=grpRisk)

grpUi = "Display"
showRibbon   = input.bool(true, "EMA ribbon", group=grpUi)
showSt       = input.bool(true, "Supertrend (split, no vertical jump)", group=grpUi)
showBg       = input.bool(true, "Tint only when HTF and local agree", group=grpUi)
showSetups   = input.bool(true, "Show small WAIT triangles (armed, no entry yet)", group=grpUi)
cooldownBars = input.int(8, "Min bars between signals", minval=1, group=grpUi)

// ── Instrument auto-detect ──────────────────────────────────────────────────
tkr = str.upper(syminfo.ticker + " " + syminfo.tickerid)
isNifty = str.contains(tkr, "NIFTY") or str.contains(tkr, "BANKNIFTY") or str.contains(tkr, "FINNIFTY")
isGold  = str.contains(tkr, "XAU") or str.contains(tkr, "GOLD") or str.contains(tkr, "XAUUSD") or str.contains(tkr, "GC1") or str.contains(tkr, "GC2") or str.contains(tkr, "MGC")

useNifty = preset == "Nifty" or (preset == "Auto" and isNifty)
useGold  = preset == "Gold" or (preset == "Auto" and isGold and not isNifty)

sessStr = preset == "Custom" ? customSess : useNifty ? "0915-1530" : "0700-1700"
inSess  = not useSession or not na(time(timeframe.period, sessStr))

stFactorEff = (preset == "Auto" and useNifty) ? 2.2 : stFactor
adxMinEff   = (preset == "Auto" and useNifty) ? 20.0 : adxMin

modeName = useNifty ? "NIFTY" : useGold ? "XAUUSD" : str.upper(syminfo.ticker)

// ── Series ──────────────────────────────────────────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaBias = ta.ema(close, emaBiasLen)

[stLine, stDir] = ta.supertrend(stFactorEff, stAtrLen)
stBull = stDir < 0 and close > stLine
stBear = stDir > 0 and close < stLine

rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

atr = ta.atr(atrLen)
volOk = atr > ta.sma(atr, 50) * atrMinMult
adxOk = adx >= adxMinEff

htfClose = request.security(syminfo.tickerid, htf, close, barmerge.gaps_off, barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htf, ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)
htfBull  = htfClose > htfEma
htfBear  = htfClose < htfEma

localBull = close > emaSlow and emaFast > emaSlow
localBear = close < emaSlow and emaFast < emaSlow

macdBull = macdHist > 0 and macdHist > macdHist[1]
macdBear = macdHist < 0 and macdHist < macdHist[1]
rsiBuyOk  = rsi >= rsiBuyMin and rsi <= rsiBuyMax
rsiSellOk = rsi >= rsiSellMin and rsi <= rsiSellMax

strictHtf = tradeMode == "HTF must agree"
conflict  = (htfBull and localBear) or (htfBear and localBull)
alignedBuy  = localBull and stBull and (not strictHtf or htfBull) and not localBear
alignedSell = localBear and stBear and (not strictHtf or htfBear)

dumpBar  = close < open and (high - close) > atr * 0.6
rallyBar = close > open and (close - low) > atr * 0.6

buyArm  = inSess and volOk and adxOk and alignedBuy and macdBull and rsiBuyOk and diPlus > diMinus
sellArm = inSess and volOk and adxOk and alignedSell and macdBear and rsiSellOk and diMinus > diPlus

buyTrigger  = (ta.crossover(close, emaFast) or (stBull and not (stDir[1] < 0)) or (buyArm and not buyArm[1])) and not dumpBar
sellTrigger = (ta.crossunder(close, emaFast) or (stBear and not (stDir[1] > 0)) or (sellArm and not sellArm[1])) and not rallyBar

buyRaw  = buyArm and buyTrigger and (not strictHtf or not conflict)
sellRaw = sellArm and sellTrigger

var int lastSigBar = na
coolOk = na(lastSigBar) or (bar_index - lastSigBar >= cooldownBars)
buySignal  = barstate.isconfirmed and buyRaw and coolOk
sellSignal = barstate.isconfirmed and sellRaw and coolOk and not buySignal
if buySignal or sellSignal
    lastSigBar := bar_index

// Score (dashboard)
buyScore = (htfBull ? 1 : 0) + (localBull ? 1 : 0) + (stBull ? 1 : 0) + (macdBull ? 1 : 0) + (rsiBuyOk ? 1 : 0) + (adxOk ? 1 : 0) + (volOk ? 1 : 0) + (inSess ? 1 : 0)
sellScore = (htfBear ? 1 : 0) + (localBear ? 1 : 0) + (stBear ? 1 : 0) + (macdBear ? 1 : 0) + (rsiSellOk ? 1 : 0) + (adxOk ? 1 : 0) + (volOk ? 1 : 0) + (inSess ? 1 : 0)

verdict = buySignal ? "BUY" : sellSignal ? "SELL" : sellArm ? "WAIT SELL (armed)" : buyArm ? "WAIT BUY (armed)" : conflict ? "HTF vs local (info)" : not adxOk ? "NO TRADE (ADX)" : not inSess ? "OUT OF SESSION" : "NO TRADE"

blockWhy = buySignal or sellSignal ? "signal bar" : not inSess ? "session" : not adxOk ? "ADX " + str.tostring(adx, "#.0") + " < " + str.tostring(adxMinEff, "#.0") : sellArm and not sellTrigger ? "need SELL trigger (EMA cross or ST flip)" : buyArm and not buyTrigger ? "need BUY trigger (EMA cross or ST flip)" : conflict ? "HTF 50 vs local EMAs differ" : "filters not aligned"

// ── Plots ───────────────────────────────────────────────────────────────────
colFast = color.new(#26a69a, 0)
colSlow = color.new(#42a5f5, 0)
pFast = plot(showRibbon ? emaFast : na, "EMA fast", colFast, 2)
pSlow = plot(showRibbon ? emaSlow : na, "EMA slow", colSlow, 2)
plot(showRibbon ? emaBias : na, "EMA bias", color.new(#ab47bc, 35), 2)
fill(pFast, pSlow, color=emaFast > emaSlow ? color.new(#26a69a, 88) : color.new(#ef5350, 88))

plot(showSt and stBull ? stLine : na, "ST bull", color.new(#00e676, 0), 2, plot.style_linebr)
plot(showSt and stBear ? stLine : na, "ST bear", color.new(#ff5252, 0), 2, plot.style_linebr)

bgTint = not showBg ? na : alignedBuy ? color.new(#00e676, 94) : alignedSell ? color.new(#ff5252, 94) : conflict ? color.new(#ffd54f, 92) : na
bgcolor(bgTint, title="Agreement tint")

plotshape(buySignal, "BUY", shape.labelup, location.belowbar, color.new(#00c853, 0), text="BUY", textcolor=color.white, size=size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color.new(#d50000, 0), text="SELL", textcolor=color.white, size=size.small)
plotshape(showSetups and buyArm and not buySignal, "BUY armed", shape.triangleup, location.belowbar, color.new(#69f0ae, 30), size=size.tiny)
plotshape(showSetups and sellArm and not sellSignal, "SELL armed", shape.triangledown, location.abovebar, color.new(#ff8a80, 30), size=size.tiny)

buySl = close - atr * slAtr
buyTp1 = close + atr * tp1Atr
buyTp2 = close + atr * tp2Atr
sellSl = close + atr * slAtr
sellTp1 = close - atr * tp1Atr
sellTp2 = close - atr * tp2Atr

if showLevels and buySignal
    line.new(bar_index, buySl, bar_index + 12, buySl, color=color.new(#ff5252, 0), width=1, style=line.style_dotted)
    line.new(bar_index, buyTp1, bar_index + 12, buyTp1, color=color.new(#69f0ae, 0), width=1, style=line.style_dotted)
    line.new(bar_index, buyTp2, bar_index + 12, buyTp2, color=color.new(#00e676, 0), width=2, style=line.style_dotted)
    label.new(bar_index, buySl, "SL " + str.tostring(buySl, format.mintick), style=label.style_label_up, color=color.new(#ff5252, 20), textcolor=color.white, size=size.tiny)
if showLevels and sellSignal
    line.new(bar_index, sellSl, bar_index + 12, sellSl, color=color.new(#ff5252, 0), width=1, style=line.style_dotted)
    line.new(bar_index, sellTp1, bar_index + 12, sellTp1, color=color.new(#69f0ae, 0), width=1, style=line.style_dotted)
    line.new(bar_index, sellTp2, bar_index + 12, sellTp2, color=color.new(#00e676, 0), width=2, style=line.style_dotted)
    label.new(bar_index, sellSl, "SL " + str.tostring(sellSl, format.mintick), style=label.style_label_down, color=color.new(#ff5252, 20), textcolor=color.white, size=size.tiny)

// Dashboard
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(#0d1117, 8), border_width=1, border_color=color.new(#37474f, 0))
dirTxt(bull, bear) =>
    bull ? "BULL" : bear ? "BEAR" : "FLAT"
dirCol(bull, bear) =>
    bull ? color.new(#00e676, 0) : bear ? color.new(#ff5252, 0) : color.new(#ffd54f, 0)
passTxt(ok) =>
    ok ? "PASS" : "FAIL"
passCol(ok) =>
    ok ? color.new(#00e676, 0) : color.new(#ff5252, 0)

if barstate.islast
    table.cell(dash, 0, 0, modeName, text_color=color.white, text_size=size.normal)
    table.cell(dash, 1, 0, verdict, text_color=buySignal ? color.new(#00e676, 0) : sellSignal ? color.new(#ff5252, 0) : (buyArm or sellArm) ? color.new(#80d8ff, 0) : conflict ? color.new(#ffd54f, 0) : color.silver, text_size=size.small)
    table.cell(dash, 0, 1, "Why", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, blockWhy, text_color=color.silver, text_size=size.small)
    table.cell(dash, 0, 2, "Score B/S", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(buyScore) + "/8  " + str.tostring(sellScore) + "/8", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "HTF", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, dirTxt(htfBull, htfBear), text_color=dirCol(htfBull, htfBear), text_size=size.small)
    table.cell(dash, 0, 4, "Local EMA", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, dirTxt(localBull, localBear), text_color=dirCol(localBull, localBear), text_size=size.small)
    table.cell(dash, 0, 5, "Supertrend", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, dirTxt(stBull, stBear), text_color=dirCol(stBull, stBear), text_size=size.small)
    table.cell(dash, 0, 6, "MACD", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, dirTxt(macdBull, macdBear), text_color=dirCol(macdBull, macdBear), text_size=size.small)
    table.cell(dash, 0, 7, "ADX " + str.tostring(adx, "#.0"), text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, passTxt(adxOk), text_color=passCol(adxOk), text_size=size.small)
    table.cell(dash, 0, 8, "RSI " + str.tostring(rsi, "#.0"), text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, rsiBuyOk ? "BUY zone" : rsiSellOk ? "SELL zone" : "mid/extreme", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 9, "Session", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 9, (inSess ? "PASS " : "FAIL ") + sessStr, text_color=passCol(inSess), text_size=size.small)

alertcondition(buySignal, "CONFLUENCE BUY", "BUY {{ticker}} {{interval}} close={{close}}")
alertcondition(sellSignal, "CONFLUENCE SELL", "SELL {{ticker}} {{interval}} close={{close}}")
if buySignal
    alert("BUY " + modeName + " SL=" + str.tostring(buySl, format.mintick) + " TP1=" + str.tostring(buyTp1, format.mintick) + " TP2=" + str.tostring(buyTp2, format.mintick), alert.freq_once_per_bar_close)
if sellSignal
    alert("SELL " + modeName + " SL=" + str.tostring(sellSl, format.mintick) + " TP1=" + str.tostring(sellTp1, format.mintick) + " TP2=" + str.tostring(sellTp2, format.mintick), alert.freq_once_per_bar_close)
